{
  "name": "sillytavern-lorebook-groups",
  "version": "0.1.0",
  "private": true,
  "description": "Group SillyTavern lorebooks without changing their content or bindings.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.36.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
